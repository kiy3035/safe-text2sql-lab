      "sql" : "SELECT COUNT(order_id) FROM analytics.orders WHERE status = 'PAID' AND ordered_at >= TIMESTAMPTZ '2024-07-01 00:00:00+00' AND ordered_at < TIMESTAMPTZ '2024-08-01 00:00:00+00'"
